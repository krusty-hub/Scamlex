{
  "manifest_version": 3,
  "name": "ScamCheck Guard",
  "version": "2.2",
  "description": "Real-time scam protection while you browse.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/scamcheck.png",
      "32": "icons/scamcheck.png",
      "48": "icons/scamcheck.png"
    }
  },
  "icons": {
    "16": "icons/scamcheck.png",
    "32": "icons/scamcheck.png",
    "48": "icons/scamcheck.png",
    "128": "icons/scamcheck.png"
  }
}